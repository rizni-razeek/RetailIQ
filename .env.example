FLASK_APP=run.py
APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-secret-key
JWT_SECRET_KEY=replace-with-a-different-random-secret-key
# Leave blank for local SQLite. Production example:
# postgresql://database-user:database-password@database-host:5432/retailiq
DATABASE_URL=
MODEL_PATH=model/retailiq_final_model.pkl
HF_MODEL_REPO=
HF_MODEL_FILENAME=
HF_TOKEN=
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=10
STOCK_OVERSTOCK_MULTIPLIER=1.5
ANOMALY_Z_THRESHOLD=2.0
